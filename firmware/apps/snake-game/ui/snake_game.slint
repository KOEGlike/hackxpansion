import "../../../xpanse/ui/fonts/ShareTechMono-Regular.ttf";

export struct SnakeCell {
    x: int,
    y: int,
}

export component SnakeGameUI inherits Window {
    width: 320px;
    height: 240px;

    in property <[SnakeCell]> snake-cells;
    in property <int> food-x: -1;
    in property <int> food-y: -1;
    in property <int> score: 0;
    in property <int> level: 2;
    in property <bool> selecting-level: true;
    in property <bool> game-over: false;
    in property <bool> won: false;

    background: #c3cbd4;
    default-font-family: "Share Tech Mono";

    for _[column] in 8: Rectangle {
        x: column * 40px;
        width: 1px;
        height: parent.height;
        background: #90a1b933;
    }

    for _[row] in 6: Rectangle {
        y: row * 40px;
        width: parent.width;
        height: 1px;
        background: #90a1b933;
    }

    Rectangle {
        x: 8px;
        y: 5px;
        width: parent.width - 16px;
        height: 25px;
        background: #94a3b880;
        border-width: 2px;
        border-color: #334155;

        Text {
            x: 8px;
            width: 190px;
            height: parent.height;
            text: "SNAKE // L" + root.level + " // SCORE " + root.score;
            color: #334155;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: 190px;
            width: parent.width - 198px;
            height: parent.height;
            text: "UP + DOWN: EXIT";
            color: #475569;
            font-size: 9px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 8px;
        y: 33px;
        width: 304px;
        height: 199px;
        background: #94a3b880;
        border-width: 3px;
        border-color: #334155;
    }

    Rectangle {
        visible: root.food-x >= 0;
        x: 10px + root.food-x * 15px + 3px;
        y: 35px + root.food-y * 15px + 3px;
        width: 9px;
        height: 9px;
        background: #b45309;
        border-width: 1px;
        border-color: #78350f;
    }

    for segment[index] in root.snake-cells: Rectangle {
        x: 10px + segment.x * 15px + 1px;
        y: 35px + segment.y * 15px + 1px;
        width: 13px;
        height: 13px;
        background: index == 0 ? #1e293b : #475569;
        border-width: 1px;
        border-color: #334155;

        Rectangle {
            visible: index == 0;
            x: 8px;
            y: 3px;
            width: 2px;
            height: 2px;
            background: #ffffff;
        }
    }

    if root.game-over: Rectangle {
        x: 34px;
        y: 76px;
        width: 252px;
        height: 104px;
        background: root.won ? #dcfce7 : #fee2e2;
        border-width: 3px;
        border-color: root.won ? #15803d : #b91c1c;

        Text {
            y: 17px;
            width: parent.width;
            text: root.won ? "BOARD CLEARED" : "SIGNAL LOST";
            color: root.won ? #14532d : #7f1d1d;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            y: 58px;
            width: parent.width;
            text: "PRESS A DIRECTION TO RETURN";
            color: root.won ? #166534 : #991b1b;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    if root.selecting-level: Rectangle {
        x: 48px;
        y: 43px;
        width: 224px;
        height: 154px;
        background: #c3cbd4f2;
        border-width: 3px;
        border-color: #334155;

        Text {
            y: 9px;
            width: parent.width;
            text: "SELECT SPEED";
            color: #334155;
            font-size: 19px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        for _[index] in 3: Rectangle {
            x: 18px;
            y: 38px + index * 29px;
            width: parent.width - 36px;
            height: 25px;
            background: root.level == index + 1 ? #1e293b : #94a3b880;
            border-width: 2px;
            border-color: #334155;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: (root.level == index + 1 ? "> " : "  ")
                    + "LEVEL " + (index + 1) + " // "
                    + (index == 0 ? "SLOW" : index == 1 ? "NORMAL" : "FAST");
                color: root.level == index + 1 ? #ffffff : #334155;
                font-size: 12px;
                font-weight: root.level == index + 1 ? 700 : 400;
                vertical-alignment: center;
            }
        }

        Text {
            y: 130px;
            width: parent.width;
            text: "UP/DOWN: LEVEL  LEFT: BACK  RIGHT: START";
            color: #475569;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}
