import "../../../xpanse/ui/fonts/ShareTechMono-Regular.ttf";

export struct BeatNote {
    lane: int,
    y: int,
}

export component NeonBeatUI inherits Window {
    width: 320px;
    height: 240px;

    in property <[BeatNote]> notes;
    in property <int> score: 0;
    in property <int> combo: 0;
    in property <int> health: 100;
    in property <string> judgement: "GET READY";
    in property <int> judgement-kind: 0;
    in property <int> active-lane: -1;
    in property <int> level: 3;
    in property <int> bpm: 120;
    in property <bool> selecting-level: true;
    in property <bool> game-over: false;

    background: #c3cbd4;
    default-font-family: "Share Tech Mono";

    for _[column] in 8: Rectangle {
        x: column * 40px;
        width: 1px;
        height: parent.height;
        background: #90a1b933;
    }

    for _[row] in 6: Rectangle {
        y: row * 40px;
        width: parent.width;
        height: 1px;
        background: #90a1b933;
    }

    Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 27px;
        background: #94a3b880;
        border-width: 2px;
        border-color: #334155;

        Text {
            x: 8px;
            width: 130px;
            height: parent.height;
            text: "NEON BEAT // L" + root.level;
            color: #334155;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: 135px;
            width: parent.width - 143px;
            height: parent.height;
            text: "SCORE " + root.score + " // x" + root.combo;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 8px;
        y: 34px;
        width: 304px;
        height: 6px;
        background: #94a3b880;
        border-width: 1px;
        border-color: #334155;

        Rectangle {
            x: 1px;
            y: 1px;
            width: root.health * 3px;
            height: 4px;
            background: root.health > 50 ? #334155 : root.health > 20 ? #b45309 : #b91c1c;
        }
    }

    Rectangle {
        x: 23px;
        y: 43px;
        width: 274px;
        height: 179px;
        background: #94a3b880;
        border-width: 3px;
        border-color: #334155;
    }

    for _[row] in 5: Rectangle {
        x: 25px;
        y: 51px + row * 39px;
        width: 270px;
        height: 1px;
        background: #64748b33;
    }

    for _[line] in 5: Rectangle {
        x: 24px + line * 68px;
        y: 45px;
        width: 1px;
        height: 175px;
        background: #64748b4d;
    }

    for _[lane] in 4: Rectangle {
        x: 25px + lane * 68px;
        y: 45px;
        width: 67px;
        height: 175px;
        background: lane == root.active-lane ? #1e293b1f : #00000000;
    }

    Rectangle {
        x: 25px;
        y: 176px;
        width: 270px;
        height: 2px;
        background: #334155;
    }

    for _[lane] in 4: Rectangle {
        x: 31px + lane * 68px;
        y: 179px;
        width: 54px;
        height: 38px;
        background: lane == root.active-lane ? #1e293b : #94a3b880;
        border-width: 2px;
        border-color: #334155;

        Text {
            width: parent.width;
            height: parent.height;
            text: lane == 0 ? "<" : lane == 1 ? "V" : lane == 2 ? "^" : ">";
            color: lane == root.active-lane ? #ffffff : #334155;
            font-size: 25px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    for note in root.notes: Rectangle {
        x: 28px + note.lane * 68px;
        y: note.y * 1px - 3px;
        width: 60px;
        height: 40px;
        background: #33415533;

        Rectangle {
            x: 3px;
            y: 3px;
            width: 54px;
            height: 34px;
            background: #1e293b;
            border-width: 3px;
            border-color: #334155;

            Text {
                width: parent.width;
                height: parent.height;
                text: note.lane == 0 ? "<" : note.lane == 1 ? "V" : note.lane == 2 ? "^" : ">";
                color: #ffffff;
                font-size: 23px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Text {
        x: 75px;
        y: 144px;
        width: 170px;
        text: root.judgement;
        color: root.judgement-kind == 3 ? #b91c1c
            : root.judgement-kind == 2 ? #475569
            : #1e293b;
        font-size: root.judgement-kind == 1 ? 22px : 17px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: 225px;
        width: parent.width;
        text: root.bpm + " BPM // UP + DOWN: EXIT";
        color: #475569;
        font-size: 10px;
        horizontal-alignment: center;
    }

    if root.game-over: Rectangle {
        x: 28px;
        y: 61px;
        width: 264px;
        height: 116px;
        background: #fee2e2;
        border-width: 3px;
        border-color: #b91c1c;

        Text {
            y: 14px;
            width: parent.width;
            text: "TRACK FAILED";
            color: #7f1d1d;
            font-size: 25px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            y: 52px;
            width: parent.width;
            text: "FINAL SCORE // " + root.score;
            color: #991b1b;
            font-size: 15px;
            horizontal-alignment: center;
        }

        Text {
            y: 82px;
            width: parent.width;
            text: "PRESS ANY ARROW TO RETURN";
            color: #991b1b;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    if root.selecting-level: Rectangle {
        x: 45px;
        y: 42px;
        width: 230px;
        height: 158px;
        background: #c3cbd4f2;
        border-width: 3px;
        border-color: #334155;

        Text {
            y: 9px;
            width: parent.width;
            text: "SELECT LEVEL";
            color: #334155;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        for _[index] in 3: Rectangle {
            x: 18px;
            y: 40px + index * 29px;
            width: parent.width - 36px;
            height: 25px;
            background: root.level == index + 1 ? #1e293b : #94a3b880;
            border-width: 2px;
            border-color: #334155;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: (root.level == index + 1 ? "> " : "  ")
                    + "LEVEL " + (index + 1) + " // "
                    + (index == 0 ? "SLOW" : index == 1 ? "QUICK" : "HYPER");
                color: root.level == index + 1 ? #ffffff : #334155;
                font-size: 12px;
                font-weight: root.level == index + 1 ? 700 : 400;
                vertical-alignment: center;
            }
        }

        Text {
            y: 134px;
            width: parent.width;
            text: "UP/DOWN: LEVEL  LEFT: BACK  RIGHT: START";
            color: #475569;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}
